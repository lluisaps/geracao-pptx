# Copie para .env e preencha. O .env NÃO vai para o repositório
# (está no .gitignore) — cada máquina tem o seu.
#
# Nenhum valor real de infraestrutura entra neste arquivo: ele é versionado.

# ---- GLPI (slide 5) -------------------------------------------------
# url:        endpoint apirest.php da instância do GLPI
# app_token:  Configurar -> Geral -> API -> Clientes de API
# user_token: Preferências -> Tokens de API
GLPI_URL=
GLPI_APP=
GLPI_USER=

# ---- Banco de execuções (slide 4) -----------------------------------
# Usuário somente leitura, restrito às tabelas de execução.
# host: hostname do servidor MySQL   porta: normalmente 3306
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
